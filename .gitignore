# =============================================================================
# Git Ignore - Previsão do Preço da Eletricidade (MIBEL Portugal)
# Proteção contra Fuga de Dados, Segredos, Credenciais e Ficheiros Locais
# =============================================================================

# --- Segredos e Variáveis de Ambiente (CRÍTICO) ---
.env
.env.*
!.env.example
*.env
secrets.yaml
credentials.json

# --- Chaves Privadas e Certificados ---
*.pem
*.key
*.pkcs12
*.pfx
*.crt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# --- Python Cache e Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Ambientes Virtuais (Virtual Environments) ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
Lib/
Scripts/

# --- IDEs e Editores de Código ---
# PyCharm
.idea/
.idea_modules/
*.iml
*.iws

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Ficheiros Temporários e do Sistema Operativo ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --- Logs e Ficheiros Temporários ---
*.log
*.tmp
*.bak
*.swp
*~
